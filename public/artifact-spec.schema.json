{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-relay.local/artifact-spec.schema.json",
  "title": "Canvas Relay Artifact Spec",
  "description": "A reusable structured artifact rendered as a table, card grid, checklist, matrix, or custom view.",
  "type": "object",
  "required": ["specVersion", "artifactType", "title", "fields", "records", "presentation"],
  "properties": {
    "specVersion": { "const": "1.0" },
    "artifactType": { "enum": ["table", "cards", "checklist", "matrix", "custom"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "type": { "enum": ["text", "number", "status", "tag", "boolean", "date", "url"] },
          "required": { "type": "boolean" },
          "options": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "presentation": {
      "type": "object",
      "required": ["layout"],
      "properties": {
        "layout": { "enum": ["table", "grid", "list"] },
        "density": { "enum": ["compact", "comfortable"] },
        "visibleFields": { "type": "array", "items": { "type": "string" }, "maxItems": 12 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
